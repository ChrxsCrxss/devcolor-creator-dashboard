# LLM provider selection.
# - Leave unset to auto-detect: uses Anthropic if ANTHROPIC_API_KEY is set, else Ollama.
# - Or force one explicitly: "anthropic" or "ollama".
# LLM_PROVIDER=anthropic

# --- Anthropic (Claude) ---
# Required to use the commercial model. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
# Model alias resolves to the latest dated build. Override to pin/upgrade.
# Examples: claude-opus-4-5, claude-opus-4-5-20251101, claude-opus-4-8, claude-opus-5
ANTHROPIC_MODEL=claude-opus-4-5
# ANTHROPIC_MAX_TOKENS=1024
# ANTHROPIC_TIMEOUT_MS=30000

# --- Ollama (local fallback) ---
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:14b-instruct
# OLLAMA_TIMEOUT_MS=90000

# --- Server ---
# PORT=5174
